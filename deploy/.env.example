COMPOSE_PROJECT_NAME=route-generator-production
RELEASE_TAG=release-2026-11-08
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

APP_NAME="DP SyS — Rutas formativas"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://rutas.example.com
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=route_generator
DB_USERNAME=route_generator
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
FILESYSTEM_DISK=local
DOCUMENT_DISK=local
DOCUMENT_RENDERER=gotenberg
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT=60

# Implementación real de App\Services\Identity\CurrentAdvisor del anfitrión.
CURRENT_ADVISOR_CLASS=
# IP/CIDR del proxy que termina HTTPS; no confíes en cabeceras de clientes arbitrarios.
TRUSTED_PROXIES=
TRUST_HUB_ORIGINS=
MAIL_MAILER=log
