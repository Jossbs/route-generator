APP_NAME="DP SyS — Rutas formativas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=route_generator
DB_USERNAME=route_generator
DB_PASSWORD=route_generator

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# El PDF de las rutas lo produce Chromium headless dentro de Gotenberg
# (compose.yaml). Con `pagina` no se genera archivo y el asesor imprime
# desde el navegador: es el respaldo para trabajar sin el contenedor.
DOCUMENT_RENDERER=gotenberg
GOTENBERG_URL=http://localhost:3001

# Centro de confianza (trust-hub/): dominios que pueden reportar eventos, separados por coma.
TRUST_HUB_ORIGINS=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# El asesor que firma lo que se cree mientras no exista el sistema anfitrión, y el
# WhatsApp al que enlaza el cierre del gancho. Sin número, el documento no pinta el
# botón y se lee igual. Ver config/identity.php.
DEVELOPMENT_ADVISOR_EMAIL=mercadotecnia@dpsys.com.mx
DEVELOPMENT_ADVISOR_WHATSAPP=

# Producción: implementación de CurrentAdvisor y proxies que terminan HTTPS.
# Vacío conserva el asesor de desarrollo, que no autentica en producción.
CURRENT_ADVISOR_CLASS=
TRUSTED_PROXIES=
